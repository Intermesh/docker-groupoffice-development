#!/bin/bash
set -e

usage() {
	cat <<EOF
Usage: $0 [-c container] [-m install|upgrade|existing]... [test path]

  -c container  Docker compose service to run in (default: groupoffice)
  -m mode       Mode to run, may be given multiple times. Runs in given order.
                  install   Fresh install (bootstrap from tests/phpunit.xml)
                  upgrade   Database upgrade (tests/bootstrap-upgrade.php)
                  existing  Existing database, with Xdebug (tests/bootstrap-none.php)
                Default: -m install
  test path     Test file or directory (default: tests)
EOF
	exit 1
}

CONT="groupoffice"
MODES=()

while getopts "c:m:h" opt; do
	case $opt in
		c) CONT=$OPTARG ;;
		m)
			case $OPTARG in
				install|upgrade|existing) MODES+=("$OPTARG") ;;
				*) echo "Invalid mode: $OPTARG" >&2; usage ;;
			esac
			;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))

P=${1:-tests}

if [ ${#MODES[@]} -eq 0 ]; then
	MODES=(install)
fi

PHPUNIT="./www/vendor/phpunit/phpunit/phpunit -c tests/phpunit.xml"

for MODE in "${MODES[@]}"; do
	case $MODE in
		install)
			echo "Running test in container $CONT with fresh install"
			docker compose exec -u www-data "$CONT" php -d apc.enable_cli=1 $PHPUNIT "$P"
			;;
		upgrade)
			echo "Running test in container $CONT with database upgrade"
			docker compose exec -u www-data "$CONT" $PHPUNIT --bootstrap="tests/bootstrap-upgrade.php" "$P"
			;;
		existing)
			echo "Running test in container $CONT on existing database"
			docker compose exec -e XDEBUG_SESSION=1 -u www-data "$CONT" $PHPUNIT --bootstrap="tests/bootstrap-none.php" "$P"
			;;
	esac
done
